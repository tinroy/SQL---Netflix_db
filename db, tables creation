
create database netflix_db;
use netflix_db;

-- creating tables

-- titles table
create table titles(
id varchar (20) primary key,
title varchar(100),
type varchar(10),
release_year char(4),
rating varchar(100),
runtime int,
imdb_score float);

-- credits table
create table credits(
person_id varchar(20) primary key,
id varchar(20),
name varchar(100),
role varchar(20),
foreign key (id) references titles(id)
);

-- to check the titles table
select *
from titles;

-- loading data into tables from csv
load data local infile "W:\\SQL Projects\\netflix db project\\titles.csv"
into table titles
fields terminated by ','
enclosed by '"'
lines terminated by '\n'
ignore 1 rows;

load data local infile "W:\\SQL Projects\\netflix db project\\credits.csv"
into table credits
fields terminated by ','
enclosed by '"'
lines terminated by '\n'
ignore 1 rows;

